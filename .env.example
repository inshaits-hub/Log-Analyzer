# ---------------------------------------------------------------------------
# Deployment settings for the root docker-compose.yml (full stack).
# Copy to .env and adjust:   cp .env.example .env
#
# .env is gitignored. Every value here is a built-in default, so
# `docker compose up --build` works with no .env at all.
# ---------------------------------------------------------------------------

# Port the dashboard is published on: http://localhost:$WEB_PORT
WEB_PORT=8080

# Used by Flask for signing. Change this before exposing the stack to anyone.
SECRET_KEY=change-me-in-production
